[Unit]
Description=Scrap Monitoring Visualizer
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service docker.service
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/scrap-monitoring-visualizer/server.env
ExecStartPre=/usr/bin/tailscale wait --timeout=120s
ExecStartPre=/usr/bin/tailscale ip --assert=${SCRAP_MONITORING_VISUALIZER_TAILNET_ADDRESS}
ExecStartPre=/usr/local/libexec/scrap-monitoring/run-visualizer validate
ExecStart=/usr/local/libexec/scrap-monitoring/run-visualizer start
ExecStop=/usr/local/libexec/scrap-monitoring/run-visualizer stop
Restart=always
RestartSec=5s
TimeoutStartSec=150s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
